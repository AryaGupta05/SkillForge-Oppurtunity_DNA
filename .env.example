# Application Settings
DATABASE_URL=sqlite:///./opportunity_dna.db
PORT=8000
HOST=127.0.0.1

# LLM & AI
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GITHUB_TOKEN=

# Email Delivery Configuration
# Options for EMAIL_PROVIDER: 'dev' or 'resend'
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM=noreply@opportunity-dna.in

# Authentication & Security
SECRET_KEY=dev-secret-key-change-in-prod
OTP_HASH_SECRET=dev-otp-secret-change-in-prod
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
